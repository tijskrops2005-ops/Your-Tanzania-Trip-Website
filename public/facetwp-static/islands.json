7/Beach-and-shaded-area-768x509.avif 768w, /wp-content/uploads/2023/07/Beach-and-shaded-area-60x40.avif 60w\" sizes=\"(max-width: 1000px) 100vw, 1000px\">        \n        <!-- Wishlist button -->\n        <div class=\"absolute top-4 left-4\">\n            <a href=\"#\" title=\"Wishlist\" class=\"flex justify-center items-center w-10 h-10 text-2xl leading-none bg-white rounded-full transition-colors group text-anthracite\" data-wishlist-post-id=\"13378\" data-wishlist-post-type=\"islands\">\n                <span class=\"i-ic-baseline-favorite-border group-hover:hidden\"></span>\n                <span class=\"hidden i-ic-baseline-favorite text-red group-hover:block\"></span>\n            </a>\n        </div>\n    </div>\n\n    <div class=\"relative w-full py-8 px-5 lg:pr-14 lg:pl-10\">\n        <div class=\"relative flex w-full flex-col\">\n            <div class=\"relative\">\n                <div class=\"mb-2 lg:mb-5 max-w-sm\">\n                    <h3 class=\"text-lg font-bold uppercase leading-6 tracking-wider text-gray-900 text-anthracite group-hover:text-yellow\">\n                        <a href=\"/islands/zanzibar-island/\">Zanzibar Island</a>\n                    </h3>\n                </div>\n\n                <div class=\"content-wrapper ts-prose\">\n                    <p class=\"line-clamp-4 !text-sm !leading-7\">Zanzibar is part of the Zanzibar Archipelago together with Pemba Island and many other smaller islands. Zanzibar Island offers a laidback beach life, but also a large variety of activities, a colorful culture and a deep history. You can go on a spice tour or explore the amazing coral reefs and swim among tropical reef […]</p>\n                </div>\n            </div>\n\n            <a class=\"mb-4 mt-6 lg:mb-0 btn btn-small btn-red xl:btn--stretched lg:btn-green !grow-0 overview-card-btn\" href=\"/islands/zanzibar-island/\">\n                View Island            </a>\n        </div>\n    </div>\n</article>"},"order":{"":["13378","13371","1