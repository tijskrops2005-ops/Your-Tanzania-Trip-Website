---
import fs from 'node:fs';
import { redesignHeader, redesignFooter, redesignBody, redesignCss } from '../lib/redesign.js';
import { readPartial, markCurrentMenu } from '../lib/site.js';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/marcellus/400.css';
import '../styles/fonts.css';
import '../styles/head.css';
import '../styles/brand.css';

const { page } = Astro.props;
const canonical = new URL(page.path, Astro.site).href;
// Language per page (default English). A later Dutch version sets `lang: "nl"` and `alternates`
// ({ en: "/path/", nl: "/nl/path/" }) in pages.json; the hreflang links below are printed only then.
const lang = page.lang || 'en';
const alternates = page.alternates ? Object.entries(page.alternates) : [];

const [headLinks, headScripts, header, footer] = await Promise.all(
  ['head-links.html', 'head-scripts.html', 'header.html', 'footer.html'].map(readPartial)
);
const hasFacets = page.extraScripts.some(s => s.includes('FWP_JSON'));
const stickyCta = page.stickyCta
  ? `<a href="${page.stickyCta.href}" class="hidden sticky-travel-proposal-btn">${page.stickyCta.label}</a>`
  : '';
const ogImage = new URL(page.ogImage || '/brand/og-image.jpg', Astro.site).href;
// Form delivery (public/assets/js/forms.js): endpoint and company e-mail from the brand tokens.
const tokens = JSON.parse(fs.readFileSync(new URL('../../docs/brand-tokens.json', import.meta.url), 'utf8'));
// Cache-busting version for the site's own scripts (changes with every build).
const renderedBody = redesignBody(await Astro.slots.render('default'), page, tokens);
// The new homepage uses its own concise questions; do not retain obsolete FAQ markup.
const pageSchemas = page.ldJson.map(json => {
  if (page.slug !== 'index') return json;
  const prune = value => {
    if (Array.isArray(value)) return value.map(prune).filter(Boolean);
    if (!value || typeof value !== 'object') return value;
    if ([value['@type']].flat().includes('FAQPage')) return null;
    return Object.fromEntries(Object.entries(value).map(([key, val]) => [key, prune(val)]));
  };
  const result = prune(JSON.parse(json));
  return result ? JSON.stringify(result) : null;
}).filter(Boolean);
const v = Date.now().toString(36);
// Google Analytics 4 with Google consent mode v2. Before any tag runs, consent defaults to
// "denied" (cookieless pings only) unless the visitor accepted earlier in the cookie banner
// (localStorage "ytt-consent", see public/assets/js/cookie-consent.js). Ads storage stays denied.
// Outside the live domain (localhost, previews) GA is switched off with Google's opt-out flag.
const ga4 = tokens.analytics?.ga4 || '';
const consentDefault = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
(function(){var c=null;try{var v=JSON.parse(localStorage.getItem("ytt-consent")||"null");if(v&&Date.now()-v.t<31536000000)c=v.c;}catch(e){}
gtag("consent","default",{analytics_storage:c==="granted"?"granted":"denied",ad_storage:"denied",ad_user_data:"denied",ad_personalization:"denied"});
if(!/(^|\\.)yourtanzaniatrip\\.com$/.test(location.hostname))window["ga-disable-${ga4}"]=true;})();`;
const gtagSnippet = `<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=${ga4}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '${ga4}');
</script>`;
const formsConfig = JSON.stringify({ endpoint: tokens.forms?.endpoint || '', email: tokens.company.email });
---
<!doctype html>
<html lang={lang === 'en' ? 'en-US' : lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {ga4 && <script is:inline set:html={consentDefault} />}
    {ga4 && <Fragment set:html={gtagSnippet} />}
    <title>{page.title}</title>
    {page.description && <meta name="description" content={page.description} />}
    {page.robots && <meta name="robots" content={page.robots} />}
    <link rel="canonical" href={canonical} />
    {alternates.map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, Astro.site).href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(page.alternates.en || page.path, Astro.site).href} />}
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_US'} />
    {page.ogType && <meta property="og:type" content={page.ogType} />}
    {page.ogTitle && <meta property="og:title" content={page.ogTitle} />}
    {page.ogDescription && <meta property="og:description" content={page.ogDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Your Tanzania Trip" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#20281B" />
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {pageSchemas.map(json => <script type="application/ld+json" set:html={json} />)}
    <script is:inline src="/assets/js/static-ajax.js"></script>
    <Fragment set:html={headLinks} />
    <Fragment set:html={page.extraStyles.join('\n')} />
    <Fragment set:html={headScripts} />
    <style is:inline set:html={redesignCss}></style>
  </head>
  <body class={page.bodyClass}>
    <Fragment set:html={markCurrentMenu(redesignHeader(header), page.path)} />
    <Fragment set:html={renderedBody} />
    <Fragment set:html={markCurrentMenu(redesignFooter(footer), page.path).replace('<!--STICKY_CTA-->', stickyCta)} />
    <Fragment set:html={page.extraScripts.join('\n')} />
    {hasFacets && <script is:inline src={`/assets/js/facetwp-static.js?v=${v}`} data-facets={`/facetwp-static/${page.slug}.json`}></script>}
    <script is:inline set:html={`window.YTT_FORMS=${formsConfig};`} />
    <script is:inline src={`/assets/js/forms.js?v=${v}`}></script>
    <script is:inline src={`/assets/js/site-search.js?v=${v}`}></script>
    <script is:inline src={`/assets/js/currency.js?v=${v}`}></script>
    <script is:inline src={`/assets/js/translate.js?v=${v}`}></script>
    <!-- Cookie banner: updates Google consent mode (analytics cookies only after "Accept") -->
    <script is:inline src={`/assets/js/cookie-consent.js?v=${v}`}></script>
    <!-- Vercel Web Analytics and Speed Insights (served by Vercel on the live domain only) -->
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/speed-insights/script.js"></script>}
  </body>
</html>
