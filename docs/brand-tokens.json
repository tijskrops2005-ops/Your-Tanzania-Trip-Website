{
  "_source": "docs/brand-style-guide.pdf (Version 1.0, October 2026). Transcribed; the PDF wins if they differ.",
  "color": {
    "forest": {
      "hex": "#20281B",
      "rgb": [
        32,
        40,
        27
      ],
      "role": "primary",
      "use": "Headings, body text, header and footer backgrounds"
    },
    "copper": {
      "hex": "#A83800",
      "rgb": [
        168,
        56,
        0
      ],
      "role": "action",
      "use": "Primary buttons and links"
    },
    "copper-dark": {
      "hex": "#8C2F00",
      "rgb": [
        140,
        47,
        0
      ],
      "role": "supporting",
      "use": "Hover and active states of buttons and links"
    },
    "gold": {
      "hex": "#E69016",
      "rgb": [
        230,
        144,
        22
      ],
      "role": "highlight",
      "use": "Highlights, icons, badges, accents on dark"
    },
    "amber": {
      "hex": "#FCAB2A",
      "rgb": [
        252,
        171,
        42
      ],
      "role": "supporting",
      "use": "Light end of sunset gradients only"
    },
    "mountain": {
      "hex": "#355248",
      "rgb": [
        53,
        82,
        72
      ],
      "role": "secondary",
      "use": "Calm section backgrounds, secondary headings, panels"
    },
    "sand": {
      "hex": "#DCC496",
      "rgb": [
        220,
        196,
        150
      ],
      "role": "neutral",
      "use": "Borders, dividers, soft panels"
    },
    "ivory": {
      "hex": "#FAF6EC",
      "rgb": [
        250,
        246,
        236
      ],
      "role": "base",
      "use": "Page background"
    },
    "white": {
      "hex": "#FFFFFF",
      "rgb": [
        255,
        255,
        255
      ],
      "role": "supporting",
      "use": "Cards and form fields"
    },
    "logo-lettering": {
      "hex": "#000800",
      "use": "Near-black lettering in the primary logo (reference only)"
    }
  },
  "proportions": {
    "ivory": 0.55,
    "forest": 0.2,
    "sand": 0.1,
    "mountain": 0.07,
    "copper": 0.05,
    "gold": 0.03
  },
  "gradient": {
    "sunset": [
      "#FCAB2A",
      "#E69016",
      "#A83800"
    ],
    "use": "Decoration only: dividers, image overlays, call-to-action band"
  },
  "contrast": {
    "forest-on-ivory": 14.1,
    "mountain-on-ivory": 7.9,
    "ivory-on-forest": 13.9,
    "forest-on-sand": 9,
    "copper-on-ivory": 6,
    "ivory-on-copper": 6,
    "gold-on-forest": 6.1,
    "copper-on-sand": {
      "ratio": 3.8,
      "allowed": false,
      "note": "Never small copper text on sand; use forest"
    }
  },
  "font": {
    "heading": {
      "family": "Marcellus",
      "source": "Google Fonts",
      "fallback": "Georgia, serif"
    },
    "body": {
      "family": "Inter",
      "weights": [
        400,
        600,
        700
      ],
      "source": "Google Fonts",
      "fallback": "Arial, sans-serif"
    }
  },
  "type-scale": {
    "display": {
      "font": "heading",
      "size": 56
    },
    "h1": {
      "font": "heading",
      "size": 40
    },
    "h2": {
      "font": "heading",
      "size": 28
    },
    "h3": {
      "font": "body",
      "weight": 600,
      "size": 20
    },
    "body": {
      "font": "body",
      "weight": 400,
      "size": 17,
      "lineHeight": 1.6,
      "minSize": 16
    },
    "small": {
      "font": "body",
      "weight": 400,
      "size": 13
    },
    "label": {
      "font": "body",
      "weight": 600,
      "size": [
        12,
        13
      ],
      "transform": "uppercase",
      "letterSpacing": "0.15em"
    }
  },
  "radius": {
    "button": 8,
    "field": 8,
    "card": 12
  },
  "component": {
    "button-primary": {
      "background": "copper",
      "text": "ivory",
      "hover": "copper-dark",
      "rule": "One primary button per screen"
    },
    "button-secondary": {
      "background": "ivory",
      "border": "1.5px forest"
    },
    "button-on-dark": {
      "border": "ivory",
      "text": "ivory"
    },
    "field": {
      "label": "persistent, above the field",
      "focus": "forest border + 2px gold ring",
      "error": "specific, below the field"
    },
    "card": {
      "background": "white or ivory",
      "border": "sand",
      "radius": 12,
      "shadow": "soft",
      "hover": "image zoom, respect prefers-reduced-motion"
    },
    "link": {
      "color": "copper",
      "decoration": "underline"
    },
    "icons": {
      "set": "one outline set, e.g. Lucide",
      "color": [
        "forest",
        "gold"
      ],
      "stroke": 1.5
    }
  },
